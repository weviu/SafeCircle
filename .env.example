POSTGRES_USER=safecircle
POSTGRES_PASSWORD=change-me
POSTGRES_DB=safecircle

# Must match the POSTGRES_* values above.
# Host "postgres" is the docker-compose service name — only reachable from
# inside the compose network (no host port is published).
DATABASE_URL=postgresql://safecircle:change-me@postgres:5432/safecircle?schema=public

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Self-hosted ntfy push transport. "ntfy" is the docker-compose service name —
# only reachable from inside the compose network or via nginx's /ntfy/ location.
# Leave empty/unset to disable push (notifications still go to the in-app inbox
# and are logged instead of published).
NTFY_BASE_URL=http://ntfy:2586
